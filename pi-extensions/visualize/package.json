{
	"name": "@thinkrail/pi-visualize",
	"version": "0.1.0",
	"description": "An oh-my-pi (omp) extension adding a `visualize` tool: mermaid diagrams and option comparisons, rendered as box-drawing in the terminal and as rich cards in hosts that have a renderer.",
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"pi-package",
		"oh-my-pi",
		"omp",
		"extension",
		"mermaid",
		"diagram",
		"visualize"
	],
	"homepage": "https://thinkrail.ai",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JetBrains/thinkrail.git",
		"directory": "pi-extensions/visualize"
	},
	"bugs": "https://github.com/JetBrains/thinkrail/issues",
	"author": "ThinkRail",
	"files": [
		"index.ts",
		"src/**/*.ts",
		"!src/**/*.test.ts",
		"README.md",
		"LICENSE"
	],
	"exports": {
		".": "./index.ts",
		"./index.ts": "./index.ts",
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"omp": {
		"extensions": [
			"./index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"lovely-mermaid": "0.3.3"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-coding-agent": "*",
		"@oh-my-pi/pi-tui": "*"
	},
	"devDependencies": {
		"@oh-my-pi/pi-coding-agent": "catalog:",
		"@oh-my-pi/pi-tui": "catalog:",
		"@types/bun": "catalog:",
		"pi-faux": "workspace:*",
		"typescript": "catalog:"
	}
}
